# Copy to .env in this folder, or export these variables in your shell.
# Never commit a real API key.

# Required: get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: full Gemini generateContent endpoint (the key is appended automatically)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent?key=

# Optional: previous variable names are still accepted
# GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent?key=
# GEMINI_KEY=your-gemini-api-key-here

# Optional server / client settings
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_CONNECT_TIMEOUT_MS=5000
GEMINI_RESPONSE_TIMEOUT_MS=30000
# Retry transient 429 / 5xx / timeout failures with exponential backoff
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_BASE_DELAY_MS=500
GEMINI_RETRY_MAX_DELAY_MS=2000
# In-memory cache for identical email + tone requests
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500
LOG_LEVEL=INFO
